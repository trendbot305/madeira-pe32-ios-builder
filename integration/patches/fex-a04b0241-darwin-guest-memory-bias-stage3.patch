+ARMEmitter::Register Arm64JITCore::ApplyGuestMemoryAddressBias(ARMEmitter::Register Address) {
+  if (!IsGuestMemoryAddressTranslationEnabled()) {
+    return Address;
+  }
+
+  if (CTX->Config.GuestMemoryAddressBias != 0) {
+    LOGMAN_THROW_A_FMT(CTX->Config.GuestMemoryAddressLimit == (1ULL << 32),
+                       "Guest memory address bias currently requires a 4GiB limit");
+  }
+
+  if (Address != TMP2) {
+    mov(ARMEmitter::Size::i64Bit, TMP2, Address);
+  }
+
+  ARMEmitter::ForwardLabel SparseAddress {};
+  ARMEmitter::ForwardLabel LinearLowAddress {};
+  ARMEmitter::ForwardLabel Done {};
+  if (CTX->Config.GuestMemoryAddressBias != 0) {
+    lsr(ARMEmitter::Size::i64Bit, TMP3, TMP2, 32);
+    (void)cbnz(ARMEmitter::Size::i64Bit, TMP3, &SparseAddress);
+    if (CTX->Config.GuestMemoryRedirectHostPage != 0) {
+      LOGMAN_THROW_A_FMT(
+        (CTX->Config.GuestMemoryRedirectGuestPage & 0xFFF) == 0
+          && (CTX->Config.GuestMemoryRedirectHostPage & 0xFFF) == 0,
+        "Guest memory redirect pages must be aligned to 4KiB");
+      ubfx(ARMEmitter::Size::i64Bit, TMP3, TMP2, 12, 20);
+      LoadConstant(
+        ARMEmitter::Size::i64Bit,
+        TMP4,
+        CTX->Config.GuestMemoryRedirectGuestPage >> 12);
+      cmp(ARMEmitter::Size::i64Bit, TMP3, TMP4);
+      (void)b(ARMEmitter::Condition::CC_NE, &LinearLowAddress);
+      and_(ARMEmitter::Size::i64Bit, TMP3, TMP2, 0xFFF);
+      LoadConstant(
+        ARMEmitter::Size::i64Bit,
+        TMP4,
+        CTX->Config.GuestMemoryRedirectHostPage);
+      add(ARMEmitter::Size::i64Bit, TMP2, TMP3, TMP4);
+      (void)b(&Done);
+      (void)Bind(&LinearLowAddress);
+    }
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP4, CTX->Config.GuestMemoryAddressBias);
+    add(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP4);
+    (void)b(&Done);
+  }
+
+  (void)Bind(&SparseAddress);
+  for (size_t Index = 0; Index < Context::GUEST_MEMORY_ADDRESS_REGION_CAPACITY; ++Index) {
+    ARMEmitter::ForwardLabel NextRegion {};
+    const auto* Region = &CTX->Config.GuestMemoryAddressRegions[Index];
+    LoadConstant(
+      ARMEmitter::Size::i64Bit,
+      TMP4,
+      reinterpret_cast<uint64_t>(&Region->GuestBase));
+    ldr(TMP3, TMP4, 0);
+    sub(ARMEmitter::Size::i64Bit, TMP3, TMP2, TMP3);
+    LoadConstant(
+      ARMEmitter::Size::i64Bit,
+      TMP4,
+      reinterpret_cast<uint64_t>(&Region->Size));
+    ldr(TMP4, TMP4, 0);
+    cmp(ARMEmitter::Size::i64Bit, TMP3, TMP4);
+    (void)b(ARMEmitter::Condition::CC_HS, &NextRegion);
+    LoadConstant(
+      ARMEmitter::Size::i64Bit,
+      TMP4,
+      reinterpret_cast<uint64_t>(&Region->HostBase));
+    ldr(TMP4, TMP4, 0);
+    add(ARMEmitter::Size::i64Bit, TMP2, TMP3, TMP4);
+    (void)b(&Done);
+    (void)Bind(&NextRegion);
+  }
+  (void)Bind(&Done);
+  return TMP2;
+}
+
+bool Arm64JITCore::IsGuestMemoryAddressTranslationEnabled() const {
+  if (CTX->Config.GuestMemoryAddressBias != 0) {
+    return true;
+  }
+  return std::any_of(
+    CTX->Config.GuestMemoryAddressRegions.begin(),
+    CTX->Config.GuestMemoryAddressRegions.end(),
+    [](const auto& Region) { return Region.Size != 0; });
+}
